{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/suguangliang3083-jpg/tableproof/v1/schemas/tableproof-report-v1.schema.json",
  "title": "TableProof Report Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "audits", "summary", "verdict"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "tableproof"},
        "version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "audits": {
      "type": "array",
      "items": {"$ref": "#/$defs/audit"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "verdict": {"enum": ["pass", "fail"]}
  },
  "$defs": {
    "summary": {
      "type": "object",
      "required": ["errors", "warnings", "infos"],
      "properties": {
        "audits": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "infos": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "duplicates": {
      "type": "object",
      "required": ["key_groups", "rows_in_groups", "excess_rows", "examples"],
      "properties": {
        "key_groups": {"type": "integer", "minimum": 0},
        "rows_in_groups": {"type": "integer", "minimum": 0},
        "excess_rows": {"type": "integer", "minimum": 0},
        "examples": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "required": ["path", "sha256", "delimiter", "rows", "columns", "key_columns", "null_key_rows", "null_key_examples", "duplicates"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "delimiter": {"enum": ["comma", "tab"]},
        "rows": {"type": "integer", "minimum": 0},
        "columns": {"type": "integer", "minimum": 1},
        "key_columns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "null_key_rows": {"type": "integer", "minimum": 0},
        "null_key_examples": {"type": "array", "items": {"type": "string"}},
        "duplicates": {"$ref": "#/$defs/duplicates"},
        "join_type": {"enum": ["inner", "left", "right", "full"]},
        "expected_rows": {"type": "integer", "minimum": 0},
        "actual_rows": {"type": "integer", "minimum": 0},
        "row_delta": {"type": "integer"},
        "missing_rows": {"type": "integer", "minimum": 0},
        "excess_rows": {"type": "integer", "minimum": 0},
        "missing_key_examples": {"type": "array", "items": {"type": "string"}},
        "excess_key_examples": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["code", "severity", "message", "context"],
      "properties": {
        "code": {"type": "string", "pattern": "^TP_[A-Z0-9_]+$"},
        "severity": {"enum": ["error", "warn", "info"]},
        "message": {"type": "string"},
        "context": {"type": "object"}
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["name", "keys", "expected_relationship", "observed_relationship", "left", "right", "unmatched", "normalization_hazards", "predictions", "selected_join_type", "result", "findings", "summary", "verdict"],
      "properties": {
        "name": {"type": "string"},
        "keys": {"type": "object"},
        "expected_relationship": {"enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"]},
        "observed_relationship": {"enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many", "unknown"]},
        "left": {"$ref": "#/$defs/table"},
        "right": {"$ref": "#/$defs/table"},
        "unmatched": {"type": "object"},
        "normalization_hazards": {"type": "object"},
        "predictions": {"type": "object"},
        "selected_join_type": {"type": ["string", "null"]},
        "result": {"anyOf": [{"$ref": "#/$defs/table"}, {"type": "null"}]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "summary": {"$ref": "#/$defs/summary"},
        "verdict": {"enum": ["pass", "fail"]}
      },
      "additionalProperties": false
    }
  }
}
